name: Market News Intelligence_NEW

on:
  workflow_dispatch:
    inputs:
      slot:
        description: "Alert slot"
        required: true
        default: "20:00"
  schedule:
    # UTC equivalents of 08:00, 13:00, 14:00, 15:00 and 20:00 IST
    - cron: "30 2 * * 1-5"
    - cron: "30 7 * * 1-5"
    - cron: "30 8 * * 1-5"
    - cron: "30 9 * * 1-5"
    - cron: "30 14 * * 1-5"

permissions:
  contents: write

jobs:
  news:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Run market news agent
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
        run: |
          if [ -n "${{ github.event.inputs.slot }}" ]; then
            SLOT="${{ github.event.inputs.slot }}"
          else
            SLOT="$(date -u +%H:%M)"
          fi
          python -m src.news_agent.main --slot "$SLOT"

      - name: Persist state
        run: |
          if git diff --quiet -- data/state.json; then
            echo "No state changes."
            exit 0
          fi
          git config user.name "market-news-agent"
          git config user.email "actions@users.noreply.github.com"
          git add data/state.json
          git commit -m "Update news agent state" || true
          git push || true
